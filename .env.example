# Required
COHERE_API_KEY=your_cohere_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Public application URL (use your deployed Streamlit URL in production)
APP_URL=http://localhost:8501

# RAG runtime
GENERATION_MODEL=command-a-03-2025
RAG_CANDIDATE_K=20
RAG_TOP_N=5
RAG_MAX_TOKENS=800
RAG_TEMPERATURE=0.0
RAG_MAX_RETRIES=2
RAG_MAX_QUERY_CHARS=2000

# Production defaults: one generation call per search.
# Set to 1 only when you explicitly want the second LLM review pass.
RAG_ENABLE_ANSWER_REVIEW=0

# Keep Cohere reranking enabled for normal production search.
# If disabled or temporarily unavailable, the app falls back to hybrid/BM25 ranking.
RAG_ENABLE_RERANKER=1
